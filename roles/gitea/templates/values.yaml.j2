extraVolumes:
  - name: fleet1-lan-ca
    configMap:
      name: fleet1-lan-ca

extraContainerVolumeMounts:
  - name: fleet1-lan-ca
    mountPath: /etc/ssl/fleet1-lan
    readOnly: true

extraInitVolumeMounts:
  - name: fleet1-lan-ca
    mountPath: /etc/ssl/fleet1-lan
    readOnly: true

deployment:
  env:
    - name: SSL_CERT_FILE
      value: /etc/ssl/fleet1-lan/ca.crt

gitea:
  admin:
    username: "{{ gitea_admin_username }}"
    password: "{{ gitea_admin_password }}"
    email: "{{ gitea_admin_email }}"
  config:
    database:
      DB_TYPE: sqlite3
    server:
      DOMAIN: gitea.fleet1.lan
      ROOT_URL: https://gitea.fleet1.lan
    oauth2_client:
      ENABLE_AUTO_REGISTRATION: true
      USERNAME: preferred_username
      UPDATE_AVATAR: true
      ACCOUNT_LINKING: login

# Disable PostgreSQL and Redis subcharts — using SQLite
postgresql-ha:
  enabled: false
postgresql:
  enabled: false
redis-cluster:
  enabled: false
redis:
  enabled: false

persistence:
  enabled: true
  storageClass: "{{ gitea_storage_class }}"
  size: "{{ gitea_pvc_size }}"
  accessModes:
    - ReadWriteOnce

ingress:
  enabled: true
  ingressClassName: traefik
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
    traefik.ingress.kubernetes.io/router.tls: "true"
  hosts:
    - host: "{{ gitea_hostname }}"
      paths:
        - path: /
          pathType: Prefix
  # gitea.fleet1.lan moved to manifests/gitea/fleet1-lan-ingressroute.yaml (mTLS enforcement)

service:
  http:
    type: ClusterIP
    port: 3000
  ssh:
    type: NodePort
    port: 22
    nodePort: 30022
