configs:
  secret:
    argocdServerAdminPassword: "{{ argocd_admin_password_bcrypt }}"
    extra:
      oidc.authentik.clientSecret: "{{ argocd_oidc_client_secret }}"
  cm:
    # Ingress resources never get a LoadBalancer IP with NodePort Traefik.
    # This custom health check marks all Ingress resources as Healthy immediately.
    resource.customizations.health.networking.k8s.io_Ingress: |
      hs = {}
      hs.status = "Healthy"
      return hs
    oidc.config: |
      name: Authentik
      issuer: https://authentik.fleet1.lan/application/o/argocd/
      clientID: argocd
      clientSecret: $oidc.authentik.clientSecret
      requestedScopes:
        - openid
        - profile
        - email
        - groups
      requestedIDTokenClaims:
        groups:
          essential: true
  rbac:
    scopes: '[groups]'
    policy.csv: |
      g, admins, role:admin

server:
  ingress:
    enabled: true
    ingressClassName: traefik
    hostname: "{{ argocd_hostname }}"
    annotations:
      traefik.ingress.kubernetes.io/router.entrypoints: websecure
      traefik.ingress.kubernetes.io/router.tls: "true"
      traefik.ingress.kubernetes.io/service.serversscheme: https
      traefik.ingress.kubernetes.io/service.serverstransport: argocd-skip-verify@kubernetescrd
    # argocd.fleet1.lan moved to manifests/argocd/fleet1-lan-ingressroute.yaml (mTLS enforcement)

dex:
  enabled: false

redis-ha:
  enabled: false

controller:
  replicas: 1

repoServer:
  replicas: 1

applicationSet:
  replicas: 1
